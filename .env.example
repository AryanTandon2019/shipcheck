# ── AI (required for full report: attack story, patches, founder brief) ──
OPENAI_API_KEY=
# Optional: use xAI instead
# XAI_API_KEY=
# AI_MODEL=gpt-4o-mini

# ── GitHub OAuth (required for Connect GitHub + Open PR) ──
# Create at https://github.com/settings/developers → New OAuth App
#   Application name: ShipCheck
#   Homepage URL: https://shipcheck-two.vercel.app  (or http://localhost:3000)
#   Authorization callback URL:
#     Production: https://shipcheck-two.vercel.app/api/github/callback
#     Local:      http://localhost:3000/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Canonical app origin (no trailing slash). Needed so OAuth redirect_uri
# matches the GitHub App callback URL on Vercel.
APP_URL=https://shipcheck-two.vercel.app

# Optional: higher GitHub API rate limits for public scans (fine-grained or classic PAT)
# GITHUB_TOKEN=
